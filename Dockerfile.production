# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Cirkel — production image
# Multi-stage build: full node:22-slim toolchain to compile, node:22-alpine
# to run. Saves ~500 MB in the final image vs. a single-stage slim build.
# ---------------------------------------------------------------------------

# ----- Stage 1: builder ----------------------------------------------------
FROM node:22-slim AS builder

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package*.json ./
RUN npm ci

# Copy the rest of the source and build.
COPY . .
RUN npm run build

# ----- Stage 2: runtime ----------------------------------------------------
FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

# wget is used by HEALTHCHECK; it ships in the base alpine image already,
# but pin it explicitly so a slimmed base still works.
RUN apk add --no-cache wget

# Copy only what the runtime needs from the builder stage.
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Drop privileges — the official node image ships an unprivileged `node` user.
RUN chown -R node:node /app
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O - http://localhost:3000/api/health || exit 1

CMD ["node", "dist/server.cjs"]
